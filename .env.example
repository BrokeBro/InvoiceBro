# ---------------------------------------------------------------------------
# Firebase web config (project: invoicebro-e0c83)
#
# These are PUBLIC by design. Firebase client config identifies the project; it
# does not grant access. Access control comes from Firebase Auth plus the
# Firestore/Storage rules. Safe to commit and to ship to the browser.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyApCxkJHd0BokZGp3lVy9SwA-cxY8CmfDM
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=invoicebro-e0c83.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=invoicebro-e0c83
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=invoicebro-e0c83.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=861556037681
NEXT_PUBLIC_FIREBASE_APP_ID=1:861556037681:web:8c8cc6367abfd437cd1d10

# ---------------------------------------------------------------------------
# Admin SDK service account — THIS IS A REAL SECRET.
#
# It bypasses every Firestore and Storage security rule. Never commit it, never
# expose it to the browser, and rotate it if it leaks.
#
# Get it from: Firebase console -> Project settings -> Service accounts ->
# "Generate new private key". Then base64-encode the whole JSON file:
#
#     base64 -w0 serviceAccountKey.json
#
# (on macOS: base64 -i serviceAccountKey.json)
#
# Base64 matters: raw multi-line JSON with embedded "\n" in the private key
# breaks env parsing on Vercel and in .env files alike.
# ---------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_KEY=

# Absolute base URL of the deployment. Used for share links.
# Local: http://localhost:3000 — on Vercel, leave unset and VERCEL_URL is used.
NEXT_PUBLIC_APP_URL=http://localhost:3000
