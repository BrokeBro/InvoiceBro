# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Firebase service account keys — never commit
*serviceAccount*.json
*firebase-adminsdk*.json
.firebase/

# Local PDF template previews
.preview/

# Two exceptions to the .env* rule above.
#
# .env holds ONLY the public Firebase web config, which is public by design and
# must be present at build time or the browser throws auth/invalid-api-key.
# .env.example is documentation.
#
# Everything secret lives in .env.local, which stays ignored by the .env* rule —
# in particular FIREBASE_SERVICE_ACCOUNT_KEY, which bypasses all security rules.
!.env
!.env.example
